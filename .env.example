# Application Configuration Example
# Copy this file to .env for local development.

PROJECT_NAME="Infrastructure Monitoring & Auto-Topology"
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# Database Configuration
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=monitoring_admin
POSTGRES_PASSWORD=change_this_in_production_secure_pass_123
POSTGRES_DB=monitoring_db

# Security & Admin Bootstrap
SECRET_KEY=change_this_to_a_secure_random_64_char_string_for_production
ACCESS_TOKEN_EXPIRE_MINUTES=480
BOOTSTRAP_ADMIN_EMAIL=admin@infra.com
BOOTSTRAP_ADMIN_PASSWORD=AdminSecurePass123!

# Prometheus Configuration
PROMETHEUS_URL=http://prometheus:9090

# Worker & Collector Configuration
STATUS_POLL_INTERVAL_SECONDS=60
INVENTORY_SCAN_INTERVAL_SECONDS=300
METRICS_COLLECT_INTERVAL_SECONDS=60
COLLECTOR_TIMEOUT_SECONDS=10
