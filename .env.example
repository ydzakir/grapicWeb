# Application Configuration Example
# Copy this file to .env and REPLACE every placeholder below with real values.
# Never commit real secrets to version control.

PROJECT_NAME="Infrastructure Monitoring & Auto-Topology"
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# Database Configuration — REPLACE the password
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=monitoring_admin
POSTGRES_PASSWORD=<replace_with_a_strong_database_password>
POSTGRES_DB=monitoring_db

# Security & Admin Bootstrap — REPLACE all values
# Generate a secret with:  python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=<replace_with_a_64_char_random_secret>
ACCESS_TOKEN_EXPIRE_MINUTES=480
BOOTSTRAP_ADMIN_EMAIL=admin@yourcompany.com
BOOTSTRAP_ADMIN_PASSWORD=<replace_with_a_strong_admin_password>

# Prometheus Configuration
PROMETHEUS_URL=http://prometheus:9090

# Worker & Collector Configuration
STATUS_POLL_INTERVAL_SECONDS=60
INVENTORY_SCAN_INTERVAL_SECONDS=300
METRICS_COLLECT_INTERVAL_SECONDS=60
COLLECTOR_TIMEOUT_SECONDS=10

# Notification & SMTP Email Delivery Configuration
NOTIFICATION_PROVIDER=log
ALERT_WEBHOOK_URL=http://your-webhook-endpoint.internal/alerts
SMTP_HOST=mail.yourcompany.com
SMTP_PORT=25
SMTP_USER=smtp_user
SMTP_PASS=smtp_password
SMTP_FROM=monitoring-alerts@yourcompany.com
SMTP_TO=devops-team@yourcompany.com
